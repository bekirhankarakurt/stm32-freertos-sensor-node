OUTPUT_DIRECTORY       = site
HTML_OUTPUT            = api
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
INPUT                  = README.md common/include app/include app/rtos firmware/drivers/include tools
FILE_PATTERNS          = *.h *.hpp *.md
